<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4A5568">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="#3B4252" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#81A1C1" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#242630" />
                    <stroke
                        android:width="1dp"
                        android:color="#3A3D4C" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
