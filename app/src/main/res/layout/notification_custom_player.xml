<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_notif_card"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical|start">

    <!-- Playback Control Buttons (Left-Aligned, Compact & Seamless) -->
    <!-- Previous Button -->
    <ImageView
        android:id="@+id/btn_notif_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_notif_btn_glass"
        android:src="@drawable/ic_notif_prev"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:contentDescription="ย้อนกลับ" />

    <!-- Play / Pause Main Button -->
    <ImageView
        android:id="@+id/btn_notif_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/bg_notif_play_amber"
        android:src="@drawable/ic_notif_pause_dark"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:contentDescription="เล่นหรือพัก" />

    <!-- Next Button -->
    <ImageView
        android:id="@+id/btn_notif_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/bg_notif_btn_glass"
        android:src="@drawable/ic_notif_next"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:contentDescription="ถัดไป" />

    <!-- Stop / Close Button -->
    <ImageView
        android:id="@+id/btn_notif_stop"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginLeft="10dp"
        android:background="@drawable/bg_notif_btn_glass"
        android:src="@drawable/ic_notif_stop"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:contentDescription="หยุด" />

</LinearLayout>

