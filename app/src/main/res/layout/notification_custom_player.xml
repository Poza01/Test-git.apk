<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_notif_card"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:gravity="center_vertical">

    <!-- Left Cover Artwork with rounded corners -->
    <FrameLayout
        android:id="@+id/notif_cover_frame"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_notif_cover_card"
        android:padding="2dp">

        <ImageView
            android:id="@+id/notif_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_app_cover_1787456498575"
            android:scaleType="centerCrop"
            android:contentDescription="Novel Cover" />
    </FrameLayout>

    <!-- Center Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="อ่านนิยายเว็บ"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Subtitle / Reading Text / Engine -->
        <TextView
            android:id="@+id/notif_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🔊 กำลังอ่านเสียงเบื้องหลัง"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Controls Action Bar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Previous Button -->
        <ImageView
            android:id="@+id/btn_notif_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_notif_btn_glass"
            android:src="@drawable/ic_notif_prev"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:contentDescription="ย้อนกลับ" />

        <!-- Play / Pause Main Button -->
        <ImageView
            android:id="@+id/btn_notif_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_notif_play_amber"
            android:src="@drawable/ic_notif_pause_dark"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:contentDescription="เล่นหรือพัก" />

        <!-- Next Button -->
        <ImageView
            android:id="@+id/btn_notif_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_notif_btn_glass"
            android:src="@drawable/ic_notif_next"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:contentDescription="ถัดไป" />
    </LinearLayout>

</LinearLayout>
